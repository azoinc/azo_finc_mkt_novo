# PostgreSQL/Supabase Database (Server-side only)
# Connection string or individual parameters
DATABASE_URL=                    # postgres://user:pass@host:port/database
# OR individual parameters:
DB_HOST=                         # ex: aws-1-sa-east-1.pooler.supabase.com
DB_PORT=6543                     # ex: 6543
DB_NAME=postgres                 # ex: postgres
DB_USER=                         # ex: postgres.xxx
DB_PASSWORD=                     # ex: your-password
DB_SSL_REJECT_UNAUTHORIZED=false # ex: false for Supabase

